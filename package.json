{
  "name": "spotstrap",
  "version": "0.0.0",
  "description": "Bootstrap's reach, shadcn's look, made for phones: Tailwind v4 tokens and classes, prebuilt CSS, and React Native recipes",
  "keywords": [
    "tailwindcss",
    "css",
    "design-system",
    "shadcn",
    "react-native",
    "uniwind"
  ],
  "homepage": "https://github.com/kodentuzo/spotstrap#readme",
  "bugs": {
    "url": "https://github.com/kodentuzo/spotstrap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodentuzo/spotstrap.git"
  },
  "license": "MIT",
  "author": "Ivan Vinski (https://www.vin.ski)",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    "./tailwind.css": "./src/tailwind.css",
    "./dark-class.css": "./src/dark-class.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/node": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
