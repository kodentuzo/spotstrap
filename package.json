{
  "name": "@kodentuzo/spotstrap",
  "version": "0.1.3",
  "description": "Bootstrap's reach, shadcn's look, made for phones: Tailwind v4 tokens and classes, prebuilt CSS, and React Native recipes",
  "keywords": [
    "tailwindcss",
    "css",
    "design-system",
    "shadcn",
    "react-native",
    "uniwind"
  ],
  "homepage": "https://github.com/kodentuzo/spotstrap#readme",
  "bugs": {
    "url": "https://github.com/kodentuzo/spotstrap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodentuzo/spotstrap.git"
  },
  "license": "MIT",
  "author": "Ivan Vinski (https://www.vin.ski)",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    "./tailwind.css": "./src/tailwind.css",
    "./dark-class.css": "./src/dark-class.css",
    "./themes/*.css": "./src/themes/*.css",
    "./dist/spotstrap.css": "./dist/spotstrap.css",
    "./dist/base.css": "./dist/base.css",
    "./dist/themes/*.css": "./dist/themes/*.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens/*.json": "./dist/tokens/*.json",
    "./js": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/spotstrap.js"
    },
    "./native.css": "./src/native.css",
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm --filter @spotstrap/site typecheck && pnpm --filter @spotstrap/site build && pnpm test",
    "prepack": "node scripts/build.ts",
    "site:dev": "pnpm --filter @spotstrap/site dev",
    "site:build": "pnpm build && pnpm --filter @spotstrap/site build"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/node": "^4.3.5",
    "@types/node": "^26.6.6",
    "@zag-js/combobox": "1.48.0",
    "@zag-js/menu": "1.48.0",
    "@zag-js/select": "1.48.0",
    "@zag-js/tabs": "1.48.0",
    "@zag-js/vanilla": "1.48.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
