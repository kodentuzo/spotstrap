---
import { GITHUB } from '../lib/site.ts'

const links = [
  { href: '/docs/getting-started', label: 'Docs' },
  { href: '/components/button', label: 'Components' },
  { href: '/docs/theming', label: 'Theming' },
]
const path = Astro.url.pathname
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 pt-[env(safe-area-inset-top)] backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center gap-(--gap-control) px-[max(1rem,env(safe-area-inset-left))]" aria-label="Main">
    <a href="/" class="btn btn-ghost -ms-3 text-headline">spotstrap</a>
    <ul class="ms-auto flex items-center gap-1 max-sm:hidden">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="btn btn-ghost btn-compact" aria-current={path.startsWith(l.href.split('/').slice(0, 2).join('/')) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={GITHUB} class="btn btn-ghost btn-icon btn-compact max-sm:ms-auto">
      <span class="sr-only">spotstrap on GitHub</span>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
    </a>
    <button type="button" class="btn btn-ghost btn-icon btn-compact" data-scheme-toggle aria-label="Switch light and dark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
    </button>
  </nav>
  <nav class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-[max(1rem,env(safe-area-inset-left))] pb-1 sm:hidden" aria-label="Sections">
    {links.map((l) => <a href={l.href} class="btn btn-ghost btn-compact">{l.label}</a>)}
  </nav>
</header>
