---
// A standalone page per example, shown in an <iframe> on its component page.
import js from 'spotstrap/js?url'
import { examples } from '../../lib/examples.ts'
import { THEME_URLS } from '../../lib/themes.ts'
import '../../styles/example.css'

export function getStaticPaths() {
  return [...examples.keys()].map((name) => ({ params: { name } }))
}

const name = Astro.params.name as string
const html = examples.get(name) ?? ''
const csp = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
---

<!doctype html>
<html lang="en" data-themes={JSON.stringify(THEME_URLS)} data-spotstrap-js={js}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{name} · spotstrap example</title>
    <link rel="stylesheet" id="theme" href={THEME_URLS.neutral} />
    <script is:inline src="/example.js"></script>
  </head>
  <body>
    <Fragment set:html={html} />
  </body>
</html>
