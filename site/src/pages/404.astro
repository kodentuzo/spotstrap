---
import Base from '../layouts/Base.astro'
---

<Base title="Not found">
  <section class="py-20">
    <h1 class="text-large-title font-semibold">Not found</h1>
    <p class="mt-2 text-body text-muted-foreground">There's no page at this address.</p>
    <div class="mt-8 flex flex-wrap gap-(--gap-control)">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-outline" href="/components/button">Components</a>
    </div>
  </section>
</Base>
